---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:5173";
const icons = {
  instagram: "/assets/icons/instagram.svg",
  whatsapp:  "/assets/icons/whatsapp.svg",
  linkedin:  "/assets/icons/linkedin.svg",
  telegram:  "/assets/icons/telegram.svg",
};
---

<footer class="mt-16 px-8 bg-[var(--primary-900)] text-[var(--secondary-50)]">
  <!-- بلوک بالا -->
  <div class="container-x grid gap-10 py-12 md:grid-cols-3">
    <!-- برند -->
    <div class="pr-4">
      <h3 class="m-0 mb-3 text-xl font-bold">Profejoo</h3>
      <p
        class="
          m-0 max-w-[28rem] leading-relaxed
          text-[color-mix(in_oklab,var(--secondary-100)80%,white)]
        "
      >
        Your trusted partner for international education and immigration services.
      </p>
    </div>

    <!-- لینک‌ها -->
    <div class="pr-4">
      <h4 class="m-0 mb-3 text-lg font-semibold">Quick Links</h4>
      <ul class="list-none space-y-2 p-0">
        <li>
          <a
            class="
              no-underline
              text-[var(--secondary-50)]
              hover:text-[var(--accent-50)]
            "
            href={`${APP_URL}/dashboard`}
          >
            Find Your Path To Apply
          </a>
        </li>
        <li>
          <a
            class="
              no-underline
              text-[var(--secondary-50)]
              hover:text-[var(--accent-50)]
            "
            href={`${APP_URL}/dashboard/plans`}
          >
            Our Plans To Offer
          </a>
        </li>
        <li>
          <a
            class="
              no-underline
              text-[var(--secondary-50)]
              hover:text-[var(--accent-50)]
            "
            href={`${APP_URL}/faq`}
          >
            FAQs
          </a>
        </li>
        <li>
          <a
            class="
              no-underline
              text-[var(--secondary-50)]
              hover:text-[var(--accent-50)]
            "
            href="/contact"
          >
            Contact Us
          </a>
        </li>
      </ul>
    </div>

    <!-- شبکه‌های اجتماعی -->
    <div class="pr-2">
      <h4 class="m-0 mb-3 text-lg font-semibold">Follow Us</h4>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="#"
          aria-label="Instagram"
          class="
            grid h-10 w-10 place-items-center rounded-full
            bg-[color-mix(in_oklab,var(--secondary-50)18%,transparent)]
            ring-1 ring-[color-mix(in_oklab,var(--secondary-200)40%,transparent)]
            hover:bg-[color-mix(in_oklab,var(--secondary-50)26%,transparent)]
          "
        >
          <img
            src={icons.instagram}
            alt=""
            class="h-5 w-5 invert opacity-95 hover:opacity-100"
          />
        </a>

        <a
          href="#"
          aria-label="WhatsApp"
          class="
            grid h-10 w-10 place-items-center rounded-full
            bg-[color-mix(in_oklab,var(--secondary-50)18%,transparent)]
            ring-1 ring-[color-mix(in_oklab,var(--secondary-200)40%,transparent)]
            hover:bg-[color-mix(in_oklab,var(--secondary-50)26%,transparent)]
          "
        >
          <img
            src={icons.whatsapp}
            alt=""
            class="h-5 w-5 invert opacity-95 hover:opacity-100"
          />
        </a>

        <a
          href="#"
          aria-label="LinkedIn"
          class="
            grid h-10 w-10 place-items-center rounded-full
            bg-[color-mix(in_oklab,var(--secondary-50)18%,transparent)]
            ring-1 ring-[color-mix(in_oklab,var(--secondary-200)40%,transparent)]
            hover:bg-[color-mix(in_oklab,var(--secondary-50)26%,transparent)]
          "
        >
          <img
            src={icons.linkedin}
            alt=""
            class="h-5 w-5 invert opacity-95 hover:opacity-100"
          />
        </a>

        <a
          href="#"
          aria-label="Telegram"
          class="
            grid h-10 w-10 place-items-center rounded-full
            bg-[color-mix(in_oklab,var(--secondary-50)18%,transparent)]
            ring-1 ring-[color-mix(in_oklab,var(--secondary-200)40%,transparent)]
            hover:bg-[color-mix(in_oklab,var(--secondary-50)26%,transparent)]
          "
        >
          <img
            src={icons.telegram}
            alt=""
            class="h-5 w-5 invert opacity-95 hover:opacity-100"
          />
        </a>
      </div>
    </div>
  </div>
<div class="w-full h-0.5 bg-[var(--accent-400)]"/>
  <!-- خط پایینی -->
  <div class="border-t border-[color-mix(in_oklab,var(--primary-600)70%,black)]">
    <div
      class="
        container-x flex flex-col items-start justify-between gap-3
        py-6 text-sm
        text-[color-mix(in_oklab,var(--secondary-100)70%,white)]
        md:flex-row md:items-center
      "
    >
      <span class="leading-6">
        ©2025 SASDim Profejoo. All rights reserved.
      </span>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a
          href="/privacy"
          class="no-underline text-inherit hover:text-[var(--secondary-50)]"
        >
          Privacy Policy
        </a>
        <a
          href="/terms"
          class="no-underline text-inherit hover:text-[var(--secondary-50)]"
        >
          Terms of Service
        </a>
        <a
          href="/cookies"
          class="no-underline text-inherit hover:text-[var(--secondary-50)]"
        >
          Cookie Policy
        </a>
      </div>
    </div>
  </div>
</footer>
