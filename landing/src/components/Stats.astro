---
---
<!-- Unicons (line icons) -->
<link
  rel="stylesheet"
  href="https://unicons.iconscout.com/release/v4.0.8/css/line.css"
/>

<section class="w-full  py-16 md:py-20 px-4">
  <div class="container-x flex flex-col items-center gap-8 text-center">
    <!-- تیتر -->
    <div class="flex flex-col items-center gap-1">
      <h2
        class="text-3xl md:text-4xl font-extrabold tracking-tight text-[var(--primary-400)]"
      >
        Study Abroad Made Easy
      </h2>
      <p class="text-sm md:text-base text-[var(--primary-400)]">
        Go global, Be Limitless
      </p>
    </div>

    <!-- کارت‌ها -->
    <div
      class="
        grid w-full max-w-6xl grid-cols-1 gap-8
        sm:grid-cols-2 lg:grid-cols-4
      "
    >
      <!-- Countries -->
      <div
        class="
          flex flex-col items-center gap-1
          rounded-3xl bg-white px-8 py-10
          shadow-[0_10px_15px_-3px_rgba(0,0,0,0.10),0_4px_6px_-1px_rgba(0,0,0,0.05)]
        "
      >
        <i class="uil uil-globe text-6xl text-[var(--secondary-400)]"></i>
        <div class="mt-3 flex flex-col items-center gap-px">
          <p class="text-4xl font-bold text-[var(--secondary-400)]">+25</p>
          <p class="text-[17px] text-[var(--primary-400)] opacity-80">
            Countries
          </p>
        </div>
      </div>

      <!-- Universities -->
      <div
        class="
          flex flex-col items-center gap-1
          rounded-3xl bg-white px-8 py-10
          shadow-[0_10px_15px_-3px_rgba(0,0,0,0.10),0_4px_6px_-1px_rgba(0,0,0,0.05)]
        "
      >
        <i class="uil uil-graduation-cap text-6xl text-[var(--secondary-400)]"></i>
        <div class="mt-3 flex flex-col items-center gap-px">
          <p class="text-4xl font-bold text-[var(--secondary-400)]">+150</p>
          <p class="text-[17px] text-[var(--primary-400)] opacity-80">
            Universities
          </p>
        </div>
      </div>

      <!-- Professors -->
      <div
        class="
          flex flex-col items-center gap-1
          rounded-3xl bg-white px-8 py-10
          shadow-[0_10px_15px_-3px_rgba(0,0,0,0.10),0_4px_6px_-1px_rgba(0,0,0,0.05)]
        "
      >
        <i class="uil uil-presentation text-6xl text-[var(--secondary-400)]"></i>
        <div class="mt-3 flex flex-col items-center gap-px">
          <p class="text-4xl font-bold text-[var(--secondary-400)]">+5000</p>
          <p class="text-[17px] text-[var(--primary-400)] opacity-80">
            Professors
          </p>
        </div>
      </div>

      <!-- Fields of Study -->
      <div
        class="
          flex flex-col items-center gap-1
          rounded-3xl bg-white px-8 py-10
          shadow-[0_10px_15px_-3px_rgba(0,0,0,0.10),0_4px_6px_-1px_rgba(0,0,0,0.05)]
        "
      >
        <i class="uil uil-book text-6xl text-[var(--secondary-400)]"></i>
        <div class="mt-3 flex flex-col items-center gap-px">
          <p class="text-4xl font-bold text-[var(--secondary-400)]">+50</p>
          <p class="text-[17px] text-[var(--primary-400)] opacity-80">
            Fields of Study
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
