<style>  /* پیش‌فرض: مخفی روی دسکتاپ */

/* نذاریم hidden کلیک‌پذیر بشه و هاور رو خراب کنه */
svg#benefits g.hidden {
  opacity: 0;
  transform: translateY(6px) scale(0.96);
  transition:
    opacity 0.25s ease-out,
    transform 0.25s ease-out;
  pointer-events: none;
}

/* روی هر hotspot که هاور شد → فقط hidden همون slice ظاهر میشه */
svg#benefits g.hotspot:hover ~ g.hidden {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* خود hotspot کلیک/هاورپذیر */
svg#benefits g.hotspot {
  cursor: pointer;
}

/* در موبایل hidden ها نمایش داده نشوند */
@media (max-width: 768px) {
  svg#benefits g.hidden {
    display: none !important;
  }
  
  svg#benefits g.hotspot {
    cursor: pointer;
  }
}

/* استایل modal */
.benefit-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.benefit-modal.hidden {
  display: none;
}

.benefit-modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
}

.benefit-modal-content {
  position: relative;
  background: white;
  border-radius: 20px;
  padding: 30px 25px;
  max-width: 85%;
  max-height: 70vh;
  overflow-y: auto;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  z-index: 10000;
}

.modal-close {
  position: absolute;
  top: 10px;
  right: 15px;
  background: none;
  border: none;
  font-size: 32px;
  cursor: pointer;
  color: #666;
  line-height: 1;
  padding: 0;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.2s;
}

.modal-close:hover {
  color: #000;
}

.modal-text {
  font-size: 16px;
  line-height: 1.6;
  color: #333;
  text-align: center;
}

.modal-text h3 {
  margin: 0 0 15px 0;
  font-size: 20px;
  color: var(--primary-400, #25274D);
}

.modal-text p {
  margin: 0;
  color: #666;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // محتوای هر slice برای modal
  const sliceContent = {
    'slice-1': 'Our powerful dashbord\nhas varous stats to make analysis for your applying roadmap',
    'slice-2': 'You have 3 different ways to make resume\nwith every thing you desire.',
    'slice-3': 'One of the benefits of our service is the large database gathered by AI',
    'slice-4': 'We have an awesome team of AI dvelopers!',
    'slice-5': 'So yeah basically a part of this is a SADISM project by some students in Iran University of Science and Technology.',
    'slice-6': 'Way cheaper than other options available right now!'
  };

  const isMobile = () => window.innerWidth <= 768;

  const modal = document.getElementById('benefit-modal');
  const modalText = document.getElementById('modal-text');
  const modalClose = document.getElementById('modal-close');
  const modalOverlay = document.querySelector('.benefit-modal-overlay');

  // بستن modal
  const closeModal = () => {
    modal?.classList.add('hidden');
  };

  modalClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeModal();
  });
  
  modalOverlay?.addEventListener('click', closeModal);

  // نمایش modal برای موبایل
  const showModal = (sliceClass) => {
    const content = sliceContent[sliceClass];
    
    if (content && modalText && modal) {
      modalText.innerHTML = content.replace(/\n/g, '<br>');
      modal.classList.remove('hidden');
    }
  };

  // برای هر slice که بازش کردیم، مرجع همون گرهِ ظاهرشده رو نگه می‌داریم
  const shownBySlice = new WeakMap();

  const getSlice = (el) =>
    el.closest('[class^="slice-"]') || el.parentNode;

  const findHiddenSibling = (slice, hotspot) =>
    Array.from(slice.children).find(
      (el) => el !== hotspot && el.classList && el.classList.contains('hidden')
    );

  // کلیک روی hotspot (برای موبایل)
  document.addEventListener('click', (e) => {
    const hotspot = e.target.closest('g.hotspot');
    
    if (!hotspot || !isMobile()) return;

    const slice = getSlice(hotspot);
    const sliceClass = slice?.getAttribute('class')?.split(' ').find(c => c.startsWith('slice-'));
    
    if (sliceClass) {
      showModal(sliceClass);
    }
  });

  // روی hotspot رفتن → نمایش (فقط دسکتاپ)
  document.addEventListener('mouseover', (e) => {
    if (isMobile()) return;

    const hotspot = e.target.closest('g.hotspot');
    if (!hotspot) return;

    if (e.relatedTarget && hotspot.contains(e.relatedTarget)) return;

    const slice = getSlice(hotspot);
    const toShow = findHiddenSibling(slice, hotspot);
    if (toShow) {
      toShow.classList.remove('hidden');
      shownBySlice.set(slice, toShow);
    }
  });

  // از hotspot خارج شدن → پنهان (فقط دسکتاپ)
  document.addEventListener('mouseout', (e) => {
    if (isMobile()) return;

    const hotspot = e.target.closest('g.hotspot');
    if (!hotspot) return;

    if (e.relatedTarget && hotspot.contains(e.relatedTarget)) return;

    const slice = getSlice(hotspot);
    const toHide = shownBySlice.get(slice);
    if (toHide && !toHide.classList.contains('hidden')) {
      toHide.classList.add('hidden');
      shownBySlice.delete(slice);
    }
  });
});
</script>